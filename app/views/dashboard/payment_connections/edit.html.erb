<% content_for :title, t("payment_providers.#{@connection.provider}.name") %>
<% provider = @connection.provider %>

<h1 class="page-title"><%= t("payment_providers.#{provider}.name") %></h1>
<p class="page-lead"><%= t("app.payments.keys_note") %></p>

<div class="stack">
  <%= render "shared/errors", record: @connection %>

  <%= form_with url: dashboard_payment_connection_path(provider), method: :patch, class: "panel" do |form| %>
    <% @connection.client_class.fields.each do |field| %>
      <div class="field">
        <%= label_tag "credentials_#{field.key}", t("payment_providers.#{provider}.fields.#{field.key}.label") %>
        <% saved = @connection.masked(field.key) %>
        <% if field.secret %>
          <%= password_field_tag "credentials[#{field.key}]", nil, id: "credentials_#{field.key}", autocomplete: "off", required: field.required && saved.nil?,
                placeholder: saved, "aria-describedby": "#{field.key}-hint" %>
        <% else %>
          <%= text_field_tag "credentials[#{field.key}]", @connection.credentials&.dig(field.key.to_s), id: "credentials_#{field.key}", autocomplete: "off", spellcheck: false,
                required: field.required, "aria-describedby": "#{field.key}-hint" %>
        <% end %>
        <p class="field__hint" id="<%= field.key %>-hint"><%= t("payment_providers.#{provider}.fields.#{field.key}.hint") %><% if field.secret && saved %> <%= t("app.payments.keep_blank") %><% end %></p>
      </div>
    <% end %>
    <div class="panel__actions">
      <%= form.submit t("app.payments.save_and_check"), class: "button" %>
      <%= link_to t("app.cancel"), dashboard_payment_connections_path %>
    </div>
  <% end %>

  <% if provider == "sumup" %>
    <section class="panel">
      <h2 class="panel__title"><%= t("app.payments.guide_title") %></h2>
      <%= render "shared/sumup_steps" %>
    </section>
  <% end %>

  <% if @connection.persisted? %>
    <section class="panel">
      <h2 class="panel__title"><%= t("app.payments.remove_title") %></h2>
      <p class="muted"><%= t("app.payments.remove_hint") %></p>
      <div class="panel__actions">
        <%= button_to t("app.payments.remove"), dashboard_payment_connection_path(provider), method: :delete, class: "button button--quiet",
              form: { onsubmit: "return confirm('#{j t("app.payments.remove_confirm")}')" } %>
      </div>
    </section>
  <% end %>
</div>
