<% content_for :title, t("app.nav.payments") %>

<h1 class="page-title"><%= t("app.nav.payments") %></h1>
<p class="page-lead"><%= t("app.payments.lead") %></p>

<div class="stack">
  <% PaymentProviders.connectable.each do |provider| %>
    <% connection = @connections[provider.key] %>
    <section class="panel terminal-row">
      <div>
        <h2 class="panel__title"><%= t("payment_providers.#{provider.key}.name") %></h2>
        <p class="muted"><%= t("payment_providers.#{provider.key}.description") %></p>
        <p class="tags">
          <% if connection&.verified_at %>
            <span class="tag"><%= t("app.payments.status_verified", date: l(connection.verified_at.to_date, format: :long)) %></span>
          <% elsif connection %>
            <span class="tag tag--pending"><%= t("app.payments.status_unverified") %></span>
          <% else %>
            <span class="tag"><%= t("app.payments.status_none") %></span>
          <% end %>
        </p>
      </div>
      <div class="row-actions">
        <%= link_to connection ? t("app.payments.change") : t("app.payments.connect"), edit_dashboard_payment_connection_path(provider.key), class: "button" %>
        <% if connection %>
          <%= button_to t("app.payments.check"), verify_dashboard_payment_connection_path(provider.key), class: "button button--quiet" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="panel">
    <h2 class="panel__title"><%= t("payment_providers.test.name") %></h2>
    <p class="muted"><%= t("payment_providers.test.description") %></p>
  </section>

  <p class="muted"><%= t("app.payments.other_providers") %> <%= mail_to Rails.configuration.x.contact_email %></p>
</div>
