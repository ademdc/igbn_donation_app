<% content_for :title, @terminal.name %>

<h1 class="page-title"><%= @terminal.name_was %></h1>
<div class="stack">
  <%= render "form", terminal: @terminal %>

  <section class="panel">
    <h2 class="panel__title"><%= t("app.terminals.delete_title") %></h2>
    <p class="muted"><%= t("app.terminals.delete_hint") %></p>
    <div class="panel__actions">
      <%= button_to t("app.terminals.delete"), dashboard_terminal_path(@terminal), method: :delete, class: "button button--quiet",
            form: { onsubmit: "return confirm('#{j t("app.terminals.delete_confirm")}')" } %>
    </div>
  </section>
</div>
