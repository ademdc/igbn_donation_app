<p><%= @account.terminal_text(:thank_you) %></p>
<p><%= t("mailers.donation.body", amount: money(@donation.amount, @donation.currency), account: @account.name) %></p>
<% if @account.receipt_footer.present? %>
  <p style="color:#3f5754;font-size:13px;"><%= simple_format(h(@account.receipt_footer), {}, wrapper_tag: "span") %></p>
<% end %>
