<% content_for :title, @account.name %>

<p><%= link_to "All accounts", admin_accounts_path %></p>

<div class="section-head">
  <h1 class="page-title"><%= @account.name %></h1>
  <%= render "admin/shared/status", account: @account %>
</div>
<p class="muted"><%= link_to @account.host, @account.url, target: "_blank", rel: "noopener" %> · signed up <%= l(@account.created_at.to_date, format: :long) %></p>

<% if @awaiting_transfers.any? %>
  <section class="panel panel--highlight" style="margin-top: 1.5rem;">
    <h2 class="panel__title">Bank transfer to confirm</h2>
    <%= render "admin/payments/awaiting", payments: @awaiting_transfers %>
  </section>
<% end %>

<div class="kpis">
  <section class="panel kpi">
    <h2 class="kpi__label">Today</h2>
    <p class="kpi__value"><%= money(@stats.today, @stats.currency, precision: 0) %></p>
  </section>
  <section class="panel kpi">
    <h2 class="kpi__label">Last 30 days</h2>
    <p class="kpi__value"><%= money(@stats.period_total, @stats.currency, precision: 0) %></p>
    <p class="kpi__note"><%= pluralize(@stats.period_count, "donation") %></p>
  </section>
  <section class="panel kpi">
    <h2 class="kpi__label">All time</h2>
    <p class="kpi__value"><%= money(@stats.all_time, @stats.currency, precision: 0) %></p>
  </section>
</div>

<div class="two-col" style="margin-top: 1.5rem;">
  <section class="panel">
    <h2 class="panel__title">Terminals</h2>
    <table class="table">
      <tbody>
        <% @terminals.each do |terminal| %>
          <tr>
            <td><%= terminal.name %><br><span class="muted"><%= terminal.hostname %></span></td>
            <td><%= terminal.payment_connection.provider %></td>
            <td class="num"><%= terminal.active? ? "On" : "Off" %><% if terminal.certificate_status %> · cert <%= terminal.certificate_status %><% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <section class="panel">
    <h2 class="panel__title">Payment providers</h2>
    <table class="table">
      <tbody>
        <% @connections.each do |connection| %>
          <tr>
            <td><%= connection.provider %></td>
            <td class="num">
              <% if connection.client_class.test_mode? %>Built in
              <% elsif connection.verified_at %>Verified <%= l(connection.verified_at.to_date, format: :short) %>
              <% else %>Not verified<% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <section class="panel">
    <h2 class="panel__title">Users</h2>
    <table class="table">
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td><%= user.name %><br><%= mail_to user.email %></td>
            <td class="num"><%= user.last_login_at ? "Last login #{l(user.last_login_at.to_date, format: :short)}" : "Never logged in" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
  <section class="panel">
    <h2 class="panel__title">Billing</h2>
    <dl class="definition-list">
      <dt>Plan</dt>
      <dd><%= money(@account.yearly_price_cents / 100.0, "EUR", precision: 0) %> a year, <%= Account::INCLUDED_TERMINALS + @account.extra_terminals %> terminal(s)</dd>
      <% if @account.paid_until %>
        <dt>Paid until</dt><dd><%= l(@account.paid_until.to_date, format: :long) %></dd>
      <% elsif @account.trial_ends_at %>
        <dt>Trial until</dt><dd><%= l(@account.trial_ends_at.to_date, format: :long) %></dd>
      <% end %>
      <% if @account.billing_name.present? %>
        <dt>Billing</dt>
        <dd><%= [@account.billing_name, @account.billing_address, @account.billing_zip, @account.billing_city, @account.country].compact_blank.join(", ") %><br><%= mail_to @account.billing_email %></dd>
      <% end %>
    </dl>
    <% if @account.paid_until.nil? %>
      <%= form_with url: extend_trial_admin_account_path(@account), class: "action-row", style: "margin-top: 1rem;" do |form| %>
        <div class="field">
          <%= form.label :days, "Days" %>
          <%= form.number_field :days, value: 14, min: 1, max: 365 %>
        </div>
        <%= form.submit "Extend trial", class: "button button--quiet" %>
      <% end %>
    <% end %>
    <% if @payments.any? %>
      <table class="table" style="margin-top: 1rem;">
        <tbody>
          <% @payments.each do |payment| %>
            <tr>
              <td><%= payment.reference %><br><span class="muted"><%= payment.description %></span></td>
              <td><%= payment.status %></td>
              <td class="num"><%= money(payment.amount_cents / 100.0, "EUR", precision: 0) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
  <section class="panel danger-zone">
    <h2 class="panel__title">Actions</h2>
    <div class="action-row">
      <%= button_to "Open dashboard as owner", impersonate_admin_account_path(@account), class: "button button--quiet", data: { turbo: false } %>
      <% if @account.suspended? %>
        <%= button_to "Reactivate", admin_account_path(@account), method: :patch, params: { account: { status: "active" } }, class: "button" %>
      <% else %>
        <%= button_to "Suspend", admin_account_path(@account), method: :patch, params: { account: { status: "suspended" } }, class: "button button--quiet",
              form: { onsubmit: "return confirm('Suspend this account? Its terminals stop taking donations.')" } %>
      <% end %>
    </div>
  </section>
</div>
